    "faq": [
      {
        "id": 15271,
        "title": "Viên uống Cholestin được sử dụng để điều trị những bệnh gì?",
        "content": "<p>Viên uống Cholestin được sử dụng trong các trường hợp: <a href=\"https://nhathuoclongchau.com.vn/benh/cholesterol-mau-cao-290.html\">Cholesterol máu cao</a>, phòng ngừa <a href=\"https://nhathuoclongchau.com.vn/benh/xo-vua-dong-mach-429.html\">xơ vữa động mạch</a>, cao huyết áp, điều trị hỗ trợ trong bệnh <a href=\"https://nhathuoclongchau.com.vn/benh/beo-phi-562.html\">béo phì</a>.</p>"
      },
      {
        "id": 15270,
        "title": "Viên uống Cholestin chứa thành phần gì?",
        "content": "<p>Viên uống Cholestin chứa thành phần Hoa Hòe, <a class=\"text-blue-500\" href=\"https://nhathuoclongchau.com.vn/thanh-phan/nghe\">Nghệ</a>, <a class=\"text-blue-500\" href=\"https://nhathuoclongchau.com.vn/thanh-phan/nguu-tat\">Ngưu tất (Rễ)</a><a class=\"text-blue-500\">. Ngưu tất có tác dụng hạ cholesterol máu và hạ huyết áp. Nghệ có tác dụng hạ cholesterol huyết, chống tạo sỏi cholesterol trong mật. Rutin có tác dụng làm tăng tính bền mao mạch.</a></p>"
      },
      {
        "id": 15274,
        "title": "Có bao nhiêu hàm lượng nghệ trong mỗi viên thuốc Cholestin?",
        "content": "<p>Có 500mg thành phần nghệ (Rhizoma curcumae longae) có trong mỗi viên thuốc Cholestin.</p>"
      },
      {
        "id": 15272,
        "title": "Viên uống Cholestin uống trước hay sau bữa ăn?",
        "content": "<p>Viên uống Cholestin dùng uống sau bữa ăn.</p>"
      },
      {
        "id": 15273,
        "title": "Phụ nữ mang thai và cho con bú có dùng thuốc Cholestin được không?",
        "content": "<p>Phụ nữ mang thai và cho con bú không được dùng thuốc Cholestin.</p>"
      }
    ],
