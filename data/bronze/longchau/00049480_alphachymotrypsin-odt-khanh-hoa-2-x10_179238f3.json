    "faq": [
      {
        "id": 37858,
        "title": "Thuốc AlphaCHYMOTRYPSIN chống chỉ định cho những trường hợp nào?",
        "content": "<p>Thuốc AlphaCHYMOTRYPSIN chống chỉ định trong các trường hợp sau: Quá mẫn với alphachymotrypsin hoặc bất kỳ thành phần nào của thuốc.</p>"
      },
      {
        "id": 37857,
        "title": "Cần thận trọng gì khi sử dụng AlphaCHYMOTRYPSIN cho những bệnh nhân có vấn đề đặc biệt về mắt?",
        "content": "<p>Không dùng hoạt chất của AlphaCHYMOTRYPSIN cho người bệnh tăng áp suất dịch kính và có vết thương hở hoặc người bệnh đục nhân mắt bẩm sinh.</p>"
      },
      {
        "id": 37856,
        "title": "Tác dụng không mong muốn thường gặp nhất của AlphaCHYMOTRYPSIN là gì?",
        "content": "<p>Tác dụng không mong muốn thường gặp nhất của hoạt chất trong AlphaCHYMOTRYPSIN là tăng nhất thời nhãn áp do các mảnh vụn dây chằng bị tiêu hủy làm tắc mạng bó dây.</p>"
      },
      {
        "id": 37855,
        "title": "Hoạt chất chính của AlphaCHYMOTRYPSIN có tác dụng dược lực học như thế nào? ",
        "content": "<p>Alphachymotrypsin là enzym phân giải protein, được điều chế bằng cách hoạt hóa chymotrypsinogen, chiết xuất từ tụy bò. Alphachymotrypsin đặc biệt cắt các liên kết chuỗi các acid amin thơm. Hoạt chất này cũng được sử dụng nhằm giúp làm lỏng các dịch tiết đường hô hấp trên ở người bệnh hen, viêm phế quản, các bệnh phổi và viêm xoang.</p>"
      },
      {
        "id": 37854,
        "title": "Thuốc AlphaCHYMOTRYPSIN được chỉ định dùng trong các trường hợp nào?",
        "content": "<p>Thuốc AlphaCHYMOTRYPSIN được chỉ định dùng trong các trường hợp sau: Điều trị phù nề sau chấn thương, phẫu thuật, bỏng.</p>"
      }
