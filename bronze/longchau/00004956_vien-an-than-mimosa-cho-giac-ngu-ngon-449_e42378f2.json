    "faq": [
      {
        "id": 13072,
        "title": "Viên an thần Mimosa là gì?",
        "content": "<p>Viên an thần Mimosa được sử dụng cho những trường hợp mất ngủ hoặc giấc ngủ đến chậm, suy nhược thần kinh. Dùng thay thế cho Diazepam khi bệnh nhân bị quen thuốc.</p>"
      },
      {
        "id": 13071,
        "title": "Thuốc an thần Mimosa dùng cho phụ nữ mang thai được không?",
        "content": "<p>Chỉ sử dụng thuốc an thần Mimosa cho phụ nữ mang thai khi có chỉ định trực tiếp từ bác sĩ.</p>"
      },
      {
        "id": 13070,
        "title": "Thuốc an thần Mimosa uống vào thời điểm nào trong ngày?",
        "content": "<p>Nên uống thuốc an thần Mimosa trước khi đi ngủ 30 - 60 phút.</p>"
      },
      {
        "id": 13069,
        "title": "Liều dùng thuốc an thần Mimosa như thế nào?",
        "content": "<p>Liều dùng thuốc an thần Mimosa:</p><ul><li>Người lớn: Uống mỗi lần 1 - 2 viên.</li><li>Trẻ em 5 - 15 tuổi: Uống nửa liều người lớn. Hoặc theo sự chỉ định của bác sĩ.</li></ul>"
      },
      {
        "id": 13068,
        "title": "Thuốc an thần Mimosa dùng cho trẻ em được không?",
        "content": "<p class=\"css-8uyn92\">Thuốc an thần Mimosa dùng cho người lớn và trẻ em 5 - 15 tuổi.</p>"
      }
    ],
