    "faq": [
      {
        "id": 32609,
        "title": "Nên bảo quản thuốc Tadimax Danapha như thế nào?",
        "content": "<p>Thuốc nên được bảo quản nơi khô thoáng, tránh ánh sáng, nhiệt độ dưới 30°C.</p>"
      },
      {
        "id": 32608,
        "title": "Cần lưu ý gì khi sử dụng thuốc Tadimax Danapha?",
        "content": "<p>Nên uống thuốc sau bữa ăn. Thuốc có chứa lactose, nên những bệnh nhân có vấn đề di truyền hiếm gặp như không dung nạp galactose, thiếu hụt lactase, hoặc kém hấp thu glucose-galactose không nên dùng thuốc này. Không dùng thuốc quá hạn hoặc khi có nghi ngờ về chất lượng thuốc. Cần đọc kỹ hướng dẫn sử dụng trước khi dùng và hỏi ý kiến bác sĩ hoặc dược sĩ để biết thêm thông tin.</p>"
      },
      {
        "id": 32607,
        "title": "Những đối tượng nào không nên sử dụng thuốc Tadimax Danapha?",
        "content": "<p>Thuốc Tadimax chống chỉ định trong các trường hợp bí tiểu hoàn toàn do các nguyên nhân khác, phụ nữ có thai và cho con bú.</p>"
      },
      {
        "id": 32605,
        "title": "Liều dùng và cách dùng thuốc Tadimax Danapha như thế nào?",
        "content": "<p>Cách dùng: Uống sau bữa ăn. Uống liên tục trong ít nhất 2 tháng. Liều dùng: Ngày uống 3 lần, mỗi lần 2 viên. Lưu ý đây chỉ là liều tham khảo, liều dùng cụ thể tùy thuộc vào thể trạng và mức độ diễn tiến của bệnh, cần tham khảo ý kiến bác sĩ hoặc chuyên viên y tế.</p>"
      },
      {
        "id": 32604,
        "title": "Thuốc Tadimax Danapha được chỉ định dùng trong những trường hợp nào?",
        "content": "<p>Thuốc Tadimax được chỉ định dùng để điều trị phì đại lành tính tuyến tiền liệt và u xơ tử cung.</p>"
      }
