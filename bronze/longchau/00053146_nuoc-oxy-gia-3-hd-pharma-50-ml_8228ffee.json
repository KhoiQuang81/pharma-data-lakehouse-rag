    "faq": [
      {
        "id": 41369,
        "title": "Có thể dùng Nước Oxy Già 3% HDPHARMA để nhỏ vào tai khi bị viêm tai không?",
        "content": "<p>Sản phẩm có chỉ định cho viêm tai nhưng chống chỉ định nhỏ vào các khoang kín của cơ thể. Việc sử dụng cho tai cần tuân thủ nghiêm ngặt theo hướng dẫn của nhân viên y tế để tránh các biến chứng không mong muốn, tuyệt đối không tự ý nhỏ trực tiếp vào trong ống tai.</p>"
      },
      {
        "id": 41368,
        "title": "Nếu vô tình nuốt phải Nước Oxy Già 3% thì có nguy hiểm không?",
        "content": "<p>Nước Oxy Già 3% là dung dịch dùng ngoài và súc miệng, không được uống. Việc nuốt phải có thể gây kích ứng đường tiêu hóa, tạo khí trong dạ dày gây khó chịu. Cần liên hệ ngay với cơ sở y tế gần nhất để được tư vấn và xử trí kịp thời.</p>"
      },
      {
        "id": 41367,
        "title": "Có cần pha loãng Nước Oxy Già 3% trước khi sử dụng không?",
        "content": "<p>Tùy vào tình trạng và vị trí tổn thương, bác sĩ có thể có những chỉ định khác. Luôn tuân thủ hướng dẫn của chuyên gia y tế.</p>"
      },
      {
        "id": 41366,
        "title": "Nước Oxy Già 3% được dùng trong những trường hợp nào?",
        "content": "<p>Nước Oxy Già 3% dùng sát khuẩn, tẩy uế, rửa vết thương, mụn nhọt đã vỡ; viêm tai, răng, miệng.</p>"
      },
      {
        "id": 41365,
        "title": "Nước Oxy Già 3% có dùng để súc miệng được không?",
        "content": "<p>Nước Oxy Già 3% dùng để súc miệng trong các trường hợp viêm nhiễm và không nên dùng quá 7 ngày. Việc sử dụng sản phẩm cần có chỉ định của bác sĩ hoặc nha sĩ.</p>"
      }
