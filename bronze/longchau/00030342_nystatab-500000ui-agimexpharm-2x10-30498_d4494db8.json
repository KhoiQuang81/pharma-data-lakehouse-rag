    "faq": [
      {
        "id": 19200,
        "title": "Thuốc Nystatab chứa thành phần gì?",
        "content": "<p>Thuốc Nystatab chứa thành phần Nystatin là một kháng sinh chống nấm được chiết xuất từ dịch nuôi cấy nấm Streptomyces noursei.</p>"
      },
      {
        "id": 19197,
        "title": "Thuốc Nystatab dùng trong trường hợp nào?",
        "content": "<p>Thuốc Nystatab dùng dự phòng và điều trị nhiễm nấm Candida ở đường tiêu hóa.</p>"
      },
      {
        "id": 19198,
        "title": "Cơ chế tác dụng của thuốc Nystatab là gì?",
        "content": "<p><i>Cơ chế tác dụng của thuốc Nystatab:</i> Do liên kết với sterol của màng tế bào các nấm nhạy cảm nên nystatin làm thay đổi tính thấm của màng nấm. Nystatin dung nạp tốt ngay cả khi điều trị lâu dài và không gây kháng thuốc.</p><p>Nystatin có tác dụng chống bội nhiễm Candida albicans đường tiêu hóa trong quá trình điều trị kháng sinh.</p>"
      },
      {
        "id": 19199,
        "title": " Cách dùng thuốc Nystatab như thế nào?",
        "content": "<p>Thuốc Nystatab dùng đường uống với liều khuyến cáo 1 – 2 viên/lần x 3 hoặc 4 lần/ngày. Liều dùng cụ thể tùy thuộc vào thể trạng và mức độ diễn tiến của bệnh. Để có liều dùng phù hợp, bạn cần tham khảo ý kiến bác sĩ hoặc chuyên viên y tế.</p>"
      },
      {
        "id": 19201,
        "title": "Thuốc Nystatab dùng đồng thời riboflavin phosphat gây ảnh hưởng như thế nào?",
        "content": "<p>Thuốc Nystatab bị mất tác dụng kháng Candida albicans nếu dùng đồng thời riboflavin phosphat.</p>"
      }
    ],
